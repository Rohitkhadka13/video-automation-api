# =============================================================================
# AI Video Automation SaaS — .env.example
# Copy this file to .env and fill in all values before running the project.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="AI Video SaaS"
APP_ENV=development                        # development | staging | production
APP_DEBUG=true                             # set false in production
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32
# Generate with: openssl rand -hex 32
APP_VERSION=0.1.0
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
API_PORT=8000
API_HOST=0.0.0.0
API_WORKERS=1                              # increase in production (1 per CPU core)
API_RELOAD=true                            # set false in production

# -----------------------------------------------------------------------------
# JWT AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_64
# Generate with: openssl rand -hex 64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=ai-video-saas

# -----------------------------------------------------------------------------
# POSTGRESQL DATABASE
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres                     # service name in docker-compose
POSTGRES_PORT=5432
POSTGRES_DB=aivideosaas
POSTGRES_USER=saas_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_SCHEMA=public

# Assembled by app/core/config.py — do NOT set manually
# DATABASE_URL=postgresql+asyncpg://user:pass@host:port/db

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800                       # recycle connections every 30 min
DB_ECHO=false                              # set true to log all SQL (dev only)

# Test database (used by pytest)
TEST_POSTGRES_DB=aivideosaas_test

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=redis                           # service name in docker-compose
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DB=0                                 # main app DB
REDIS_CELERY_DB=1                          # Celery broker DB
REDIS_CACHE_DB=2                           # cache DB
REDIS_MAX_CONNECTIONS=50

# Assembled by app/core/config.py — do NOT set manually
# REDIS_URL=redis://:password@host:port/db
# CELERY_BROKER_URL=redis://:password@host:port/1
# CELERY_RESULT_BACKEND=redis://:password@host:port/1

# -----------------------------------------------------------------------------
# CELERY
# -----------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false             # set true to run tasks synchronously in tests
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_SEND_SENT_EVENT=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1        # fairness for long-running video tasks
CELERY_TASK_ACKS_LATE=true                 # re-queue on worker crash
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_BACKOFF=true
CELERY_TASK_RETRY_BACKOFF_MAX=600          # cap backoff at 10 minutes

# Queue routing (comma-separated)
CELERY_VIDEO_QUEUE=video
CELERY_TRANSCRIPTION_QUEUE=transcription
CELERY_TTS_QUEUE=tts

# -----------------------------------------------------------------------------
# FLOWER (Celery monitoring)
# -----------------------------------------------------------------------------
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_flower_password

# -----------------------------------------------------------------------------
# OLLAMA / LLAMA 3
# -----------------------------------------------------------------------------
OLLAMA_HOST=http://ollama                  # service name in docker-compose
OLLAMA_PORT=11434
OLLAMA_MODEL=llama3                        # or llama3:8b, llama3:70b
OLLAMA_TIMEOUT=120                         # seconds — large models are slow
OLLAMA_MAX_TOKENS=4096
OLLAMA_TEMPERATURE=0.7
OLLAMA_KEEP_ALIVE=5m                       # keep model loaded in VRAM

# Script generation prompt template (overridable per-project)
OLLAMA_SYSTEM_PROMPT="You are a professional video script writer. Generate concise, engaging scripts."

# -----------------------------------------------------------------------------
# WHISPER (speech-to-text transcription)
# -----------------------------------------------------------------------------
WHISPER_MODEL=base                         # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu                         # cpu | cuda | mps
WHISPER_COMPUTE_TYPE=int8                  # int8 | float16 | float32
WHISPER_LANGUAGE=auto                      # auto or ISO code e.g. en, es, fr
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true                    # voice activity detection filter

# -----------------------------------------------------------------------------
# PIPER TTS (text-to-speech)
# -----------------------------------------------------------------------------
PIPER_EXECUTABLE=/usr/local/bin/piper     # path inside Docker image
PIPER_MODELS_DIR=/app/models/piper         # mounted volume in production
PIPER_DEFAULT_MODEL=en_US-lessac-medium    # voice model name
PIPER_SAMPLE_RATE=22050
PIPER_OUTPUT_FORMAT=wav

# -----------------------------------------------------------------------------
# FFMPEG
# -----------------------------------------------------------------------------
FFMPEG_EXECUTABLE=/usr/bin/ffmpeg
FFPROBE_EXECUTABLE=/usr/bin/ffprobe
FFMPEG_THREADS=0                           # 0 = auto (use all available cores)
FFMPEG_PRESET=medium                       # ultrafast|superfast|fast|medium|slow
FFMPEG_VIDEO_CODEC=libx264
FFMPEG_AUDIO_CODEC=aac
FFMPEG_OUTPUT_FORMAT=mp4
FFMPEG_DEFAULT_CRF=23                      # 0=lossless, 23=default, 51=worst
FFMPEG_MAX_DURATION_SECONDS=3600           # 1 hour max video length
FFMPEG_THUMBNAIL_SECOND=5                  # extract thumbnail at this second

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local                      # local | s3
MEDIA_ROOT=/app/media                      # local storage base directory
MEDIA_URL=/media/                          # public URL prefix served by Nginx
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,avi,mkv,webm
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,aac,ogg,m4a

# S3-compatible storage (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET_NAME=ai-video-saas-media
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_REGION=us-east-1
S3_PRESIGNED_URL_EXPIRY=3600               # seconds

# -----------------------------------------------------------------------------
# NGINX
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60          # per authenticated user
RATE_LIMIT_BURST=20                        # burst allowance

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                            # json | console (json for prod)
LOG_FILE=/app/logs/app.log                 # leave empty to disable file logging
LOG_ROTATION=500 MB
LOG_RETENTION=10 days

# -----------------------------------------------------------------------------
# MONITORING / TRACING (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=                                # leave empty to disable Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1              # 10% of transactions
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# EMAIL (optional — for notifications)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASSWORD=CHANGE_ME_app_password
SMTP_FROM_EMAIL=noreply@aivideosaas.com
SMTP_FROM_NAME="AI Video SaaS"
SMTP_TLS=true
SMTP_ENABLED=false                         # set true to enable email sending

# -----------------------------------------------------------------------------
# FIRST ADMIN USER (created on first run via init_db.py)
# -----------------------------------------------------------------------------
FIRST_SUPERUSER_EMAIL=admin@aivideosaas.com
FIRST_SUPERUSER_PASSWORD=CHANGE_ME_admin_password
FIRST_SUPERUSER_FULL_NAME="System Admin"
